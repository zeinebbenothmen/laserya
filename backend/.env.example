# ─────────────────────────────────────────────────────────────
# Configuration e-mail (envoi du code de suivi après une commande)
# Copiez ce fichier en  backend/.env  et remplissez vos identifiants.
# Redémarrez le serveur après modification.
# Analyse des devis d’impression 3D (clé gardée côté serveur)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-astra
# ─────────────────────────────────────────────────────────────

# Serveur SMTP de votre fournisseur d'e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
# Gmail : créez un "mot de passe d'application" (compte Google → Sécurité → Mots de passe des applications)
SMTP_PASS=xxxxxxxxxxxxxxxx

# Expéditeur affiché dans l'e-mail
MAIL_FROM=Laserya.tn <votre-adresse@gmail.com>

# URL publique du site (pour le lien de suivi dans l'e-mail)
SITE_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# (Optionnel) Sécurité — à définir avant la mise en ligne :
# JWT_SECRET=une-cle-secrete-longue-et-aleatoire
# ─────────────────────────────────────────────────────────────
